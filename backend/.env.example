# ── LLM ──
API_BASE_URL=http://localhost:8000/llm-gateway/v1
API_TOKEN=your-api-token-here
MODEL_NAME=qwen3-30b-a3b-instruct-2507

# ── MySQL ──
DB_HOST=172.16.2.25
DB_PORT=3306
DB_USER=crawler_workflow
DB_PASSWORD=your-db-password
DB_NAME=crawler_workflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ──
# 哨兵模式（对接运行环境）
REDIS_SENTINEL_NODES=sentinel-host1:28001,sentinel-host2:28002,sentinel-host3:28003
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_PASSWORD=your-sentinel-password
REDIS_PASSWORD=your-redis-password
REDIS_DB=2
# 单机模式（本地开发时改用以下配置）
# REDIS_URL=redis://127.0.0.1:6379/0

# ── 用户中心 OAuth2 ──
USER_CENTER_BASE_URI=https://test.zhongshu.tech/pbc/usercenter
USER_CENTER_CLIENT_ID=kl-repo-pbc-svr
USER_CENTER_CLIENT_SECRET=your-client-secret
USER_CENTER_SCOPE=basic name mobile certif-id verification grant user-id
# redirect_uri 和 frontend_url 在生产环境会从请求头自动推导（X-Forwarded-*），
# 无需手动配置。以下仅作为本地开发 fallback。
# 部署时仅需确保 Nginx 透传以下请求头：
#   X-Forwarded-Proto: https
#   X-Forwarded-Host: test.zhongshu.tech
#   X-Forwarded-Prefix: /crawler-studio
USER_CENTER_REDIRECT_URI=http://127.0.0.1:3101/api/auth/callback
USER_CENTER_FRONTEND_URL=http://127.0.0.1:3101

# ── 会话与安全 ──
SESSION_TTL_HOURS=24
OAUTH_STATE_TTL_SECONDS=600
