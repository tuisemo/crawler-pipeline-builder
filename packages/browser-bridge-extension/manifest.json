{
  "manifest_version": 3,
  "name": "Browser Bridge for Crawler",
  "version": "1.0.0",
  "description": "General purpose browser bridge for web crawlers and RPA tasks.",
  "permissions": ["tabs", "scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:3101/*",
      "http://localhost:3101/*",
      "http://127.0.0.1/*",
      "http://localhost/*",
      "https://*.sea-data.io/*"
    ]
  },
  "background": {
    "service_worker": "dist/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/src/popup/popup.html"
  }
}
