{
  "name": "browser-bridge-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:key": "node ./scripts/ensure-key.mjs",
    "build": "npm run prepare:key && vite build",
    "package:unpacked": "node ./scripts/package.mjs unpacked",
    "package:zip": "node ./scripts/package.mjs zip",
    "build:unpacked": "npm run build && npm run package:unpacked",
    "build:zip": "npm run build:unpacked && npm run package:zip",
    "copy:frontend": "node ./scripts/package.mjs frontend",
    "build:frontend": "npm run build && npm run copy:frontend"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "typescript": "^6.0.2",
    "vite": "^8.0.9"
  }
}